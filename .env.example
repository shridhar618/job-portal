# PostgreSQL database (free: https://neon.tech or https://supabase.com)
# DATABASE_URL = pooled connection string (used by the app at runtime)
# DIRECT_URL   = direct (non-pooled) connection string (used by `prisma db push`)
# If your provider gives you only one string, use it for both.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Secret used to sign login session cookies — use a long random string
# (generate one with: openssl rand -hex 32)
SESSION_SECRET="replace-with-a-long-random-string-at-least-32-chars"

# Vercel Blob token for resume uploads. Vercel sets this automatically when you
# connect a Blob store to the project. Leave it unset locally to store resumes
# in uploads/resumes/ instead.
# BLOB_READ_WRITE_TOKEN=
